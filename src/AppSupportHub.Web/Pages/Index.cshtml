@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero" aria-labelledby="page-title">
    <span class="phase-label">Live portfolio demo</span>
    <h1 id="page-title">AppSupportHub</h1>
    <p class="lead">
        A server-rendered application-support and change-management portfolio portal.
    </p>
    <p>
        Explore fictional application systems and their incidents, enhancements, and change
        requests through public read-only Systems, WorkItems, and Operations journeys. PostgreSQL
        persistence and immutable work-item history sit behind the same Application workflows.
    </p>
    <div class="d-flex flex-wrap gap-2 mt-4">
        <a class="btn btn-primary" asp-page="/Systems/Index">Browse systems</a>
        <a class="btn btn-outline-primary" asp-page="/WorkItems/Index">Browse work items</a>
        <a class="btn btn-outline-primary" asp-page="/Operations/Index">View operations</a>
    </div>
</section>

<section class="foundation-grid" aria-label="Application support capabilities">
    <article>
        <h2>System inventory</h2>
        <p>Create, search, update, and make confirmed lifecycle changes without physical deletion.</p>
    </article>
    <article>
        <h2>Support workflows</h2>
        <p>Track assignments, priorities, UTC due dates, status transitions, and immutable history.</p>
    </article>
    <article>
        <h2>Versioned API</h2>
        <p>Use the documented <a href="/openapi/v1.json">REST API v1 OpenAPI document</a> for the same workflows.</p>
    </article>
</section>

<aside class="disclaimer" aria-label="Project disclaimer">
    AppSupportHub is an independent portfolio project. It is not affiliated with, endorsed by,
    or built for the City of Winnipeg. All optional demo records are fictional.
</aside>
