<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppSupportHub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppSupportHub.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom" aria-label="Primary navigation">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">AppSupportHub</a>
                <ul class="navbar-nav flex-row flex-wrap gap-2 ms-md-auto">
                    @{
                        string currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
                    }
                    <li class="nav-item">
                        <a class="nav-link" aria-current="@(currentPage == "/Index" ? "page" : null)" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" aria-current="@(currentPage.StartsWith("/Systems", StringComparison.Ordinal) ? "page" : null)" asp-page="/Systems/Index">Systems</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" aria-current="@(currentPage.StartsWith("/WorkItems", StringComparison.Ordinal) ? "page" : null)" asp-page="/WorkItems/Index">Work Items</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" aria-current="@(currentPage == "/LegacyImports" ? "page" : null)" asp-page="/LegacyImports">Legacy CSV Preview</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/openapi/v1.json">API document</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        string role = User.IsInRole(SecurityRoles.Administrator)
                            ? SecurityRoles.Administrator
                            : SecurityRoles.Analyst;
                        <li class="nav-item"><span class="nav-link">@User.Identity.Name (@role)</span></li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Account/Login" asp-page-handler="Logout">
                                <button type="submit" class="btn btn-link nav-link">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Account/Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
        <div class="demo-notice" role="note">
            <div class="container">Public read-only portfolio demo — authentication is required to change data</div>
        </div>
    </header>
    <div class="container">
        <main id="main-content" class="pb-3" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 AppSupportHub &middot; Independent portfolio project &middot;
            Not affiliated with or endorsed by the City of Winnipeg
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
