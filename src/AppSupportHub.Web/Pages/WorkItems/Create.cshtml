@page "/WorkItems/Create"
@model AppSupportHub.Web.Pages.WorkItems.CreateModel
@{
    ViewData["Title"] = "Create work item";
}

<h1>Create work item</h1>
<p class="text-muted">Due date input is interpreted as UTC. Retired systems are not selectable.</p>

<form method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Input.ApplicationSystemId" class="form-label"></label>
        <select asp-for="Input.ApplicationSystemId" class="form-select">
            <option value="">Choose an application system</option>
            @foreach (var system in Model.SelectableSystems)
            {
                <option value="@system.Id">@system.Name (@system.LifecycleStatusName)</option>
            }
        </select>
        <span asp-validation-for="Input.ApplicationSystemId" class="text-danger"></span>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.Type" class="form-label"></label>
            <select asp-for="Input.Type" class="form-select">
                <option value="">Choose a type</option>
                @foreach (string option in Model.Types)
                {
                    <option value="@option">@option</option>
                }
            </select>
            <span asp-validation-for="Input.Type" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Priority" class="form-label"></label>
            <select asp-for="Input.Priority" class="form-select">
                <option value="">Choose priority</option>
                @foreach (string option in Model.Priorities)
                {
                    <option value="@option">@option</option>
                }
            </select>
            <span asp-validation-for="Input.Priority" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3 mt-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.DueAtUtc" class="form-label"></label>
        <input asp-for="Input.DueAtUtc" type="datetime-local" class="form-control" />
        <div class="form-text">UTC; leave blank for no due date.</div>
        <span asp-validation-for="Input.DueAtUtc" class="text-danger"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create work item</button>
        <a class="btn btn-link" asp-page="Index">Cancel</a>
    </div>
</form>
